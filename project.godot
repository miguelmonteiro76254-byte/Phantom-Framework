; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Phantom Framework"
run/main_scene="uid://fpvndu8s1vlv"
config/features=PackedStringArray("4.8", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[autoload]

LivesSonic="*res://Scripts/Player/lives.gd"
ScreenFade="*res://Scripts/Hud/Fade_Screen.gd"
Debug="*res://Scripts/Hud/Debug.gd"
Score="*uid://cu12ig76fwxdb"
LevelSelectS2="*uid://dy8h107ylw7ys"
Emeralds="*uid://dqxn1hea4tq0l"
Checkpoint="*uid://dk1buxriowljn"

[display]

window/size/viewport_width=320
window/size/viewport_height=240
window/size/mode=4
window/size/resizable=false
window/stretch/mode="viewport"

